{
  "name": "vscode-vibeflow",
  "displayName": "VibeFlow",
  "description": "Ship faster with a full AI engineering team — Developer, Architect, QA, Security, and PM agents that know your codebase and do the work.",
  "author": {
    "name": "Axiom Studio AI",
    "url": "https://axiomstudio.ai"
  },
  "version": "1.1.2",
  "publisher": "AxiomStudio",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/axiom-studio/vscode-vibeflow.git"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.vibeflow-session-*",
    "onStartupFinished"
  ],
  "icon": "media/icon.png",
  "keywords": [
    "ai",
    "agent",
    "agents",
    "vibeflow",
    "orchestration",
    "multi-agent",
    "project-management",
    "claude",
    "codex",
    "cursor",
    "gemini",
    "kanban",
    "compliance",
    "pair-programming",
    "autonomous"
  ],
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "qna": false,
  "bugs": {
    "url": "https://github.com/axiom-studio/vscode-vibeflow/issues",
    "email": "support@axiomstudio.ai"
  },
  "homepage": "https://cloud.axiomstudio.ai",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vibeflow",
          "title": "VibeFlow",
          "icon": "media/vibeflow-icon.svg"
        }
      ],
      "panel": [
        {
          "id": "vibeflowMonitor",
          "title": "VibeFlow Monitor",
          "icon": "media/vibeflow-icon.svg"
        }
      ]
    },
    "views": {
      "vibeflow": [
        {
          "id": "vibeflow.welcome",
          "name": "Welcome",
          "type": "tree",
          "when": "!vibeflow.configured"
        },
        {
          "id": "vibeflow.agentFleet",
          "name": "Agent Fleet",
          "type": "tree",
          "when": "vibeflow.configured"
        },
        {
          "id": "vibeflow.workItems",
          "name": "Work Items",
          "type": "tree",
          "when": "vibeflow.configured"
        },
        {
          "id": "vibeflow.browse",
          "name": "Browse",
          "type": "tree",
          "when": "vibeflow.configured"
        },
        {
          "id": "vibeflow.pullRequests",
          "name": "Pull Requests",
          "type": "tree",
          "visibility": "collapsed",
          "when": "vibeflow.configured"
        },
        {
          "id": "vibeflow.documents",
          "name": "Documents",
          "type": "tree",
          "visibility": "collapsed",
          "when": "vibeflow.configured"
        }
      ],
      "vibeflowMonitor": [
        {
          "id": "vibeflow.activityFeed",
          "name": "Activity Feed",
          "type": "webview",
          "retainContextWhenHidden": true
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "vibeflow.welcome",
        "contents": "Welcome to VibeFlow!\n\nConnect to your VibeFlow server to manage your agent fleet, work items, project items, and documents.\n\n[Get Started](command:vibeflow.setup)\n\nYou'll be asked for your server URL, API key, and project."
      }
    ],
    "chatParticipants": [
      {
        "id": "vibeflow.chat",
        "name": "vibeflow",
        "fullName": "VibeFlow",
        "description": "AI agent orchestration and project management",
        "isSticky": false,
        "commands": [
          {
            "name": "status",
            "description": "Check project, feature, and session status"
          },
          {
            "name": "create",
            "description": "Create a feature, todo, or issue"
          },
          {
            "name": "review",
            "description": "View items needing QA or security review"
          },
          {
            "name": "summary",
            "description": "Get work summary and metrics"
          },
          {
            "name": "launch",
            "description": "Launch an agent session"
          },
          {
            "name": "respond",
            "description": "Respond to a pending agent prompt"
          },
          {
            "name": "compliance",
            "description": "Show open compliance findings for this project"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "vibeflow.setup",
        "title": "VibeFlow: Setup"
      },
      {
        "command": "vibeflow.login",
        "title": "VibeFlow: Login"
      },
      {
        "command": "vibeflow.logout",
        "title": "VibeFlow: Logout"
      },
      {
        "command": "vibeflow.launchSession",
        "title": "VibeFlow: Launch Session",
        "icon": "$(play)"
      },
      {
        "command": "vibeflow.createWorkItem",
        "title": "VibeFlow: Create Work Item",
        "icon": "$(add)"
      },
      {
        "command": "vibeflow.createDocument",
        "title": "VibeFlow: Create Document",
        "icon": "$(new-file)"
      },
      {
        "command": "vibeflow.viewSessions",
        "title": "VibeFlow: View Sessions"
      },
      {
        "command": "vibeflow.respondToPrompt",
        "title": "VibeFlow: Respond to Prompt"
      },
      {
        "command": "vibeflow.openDashboard",
        "title": "VibeFlow: Open Dashboard",
        "icon": "$(graph)"
      },
      {
        "command": "vibeflow.openKanban",
        "title": "VibeFlow: Open Kanban Board",
        "icon": "$(layout-centered)"
      },
      {
        "command": "vibeflow.openTickets",
        "title": "VibeFlow: Open Tickets Table",
        "icon": "$(table)"
      },
      {
        "command": "vibeflow.openCompliance",
        "title": "VibeFlow: Open Compliance",
        "icon": "$(shield)"
      },
      {
        "command": "vibeflow.openBrainstorm",
        "title": "VibeFlow: Open Brainstorm",
        "icon": "$(lightbulb)"
      },
      {
        "command": "vibeflow.installCli",
        "title": "VibeFlow: Install Latest CLI",
        "icon": "$(cloud-download)"
      },
      {
        "command": "vibeflow.bootstrapCli",
        "title": "VibeFlow: Configure MCP for Coding Agents",
        "icon": "$(plug)"
      },
      {
        "command": "vibeflow.uninstallCli",
        "title": "VibeFlow: Remove MCP Config",
        "icon": "$(trash)"
      },
      {
        "command": "vibeflow.checkCliUpdate",
        "title": "VibeFlow: Check for CLI Updates",
        "icon": "$(sync)"
      },
      {
        "command": "vibeflow.browseCliBinary",
        "title": "VibeFlow: Browse for CLI Binary…",
        "icon": "$(folder-opened)"
      },
      {
        "command": "vibeflow.pickProject",
        "title": "VibeFlow: Switch Project…",
        "icon": "$(folder)"
      },
      {
        "command": "vibeflow.reportIssue",
        "title": "VibeFlow: Report an Issue…",
        "icon": "$(bug)"
      },
      {
        "command": "vibeflow.manageWorktrees",
        "title": "VibeFlow: Manage Worktrees"
      },
      {
        "command": "vibeflow.changeStatus",
        "title": "VibeFlow: Change Status"
      },
      {
        "command": "vibeflow.changePriority",
        "title": "VibeFlow: Change Priority"
      },
      {
        "command": "vibeflow.checkBranchStatus",
        "title": "VibeFlow: Check Branch Review Status"
      },
      {
        "command": "vibeflow.createPR",
        "title": "VibeFlow: Create Pull Request"
      },
      {
        "command": "vibeflow.qaVerify",
        "title": "VibeFlow: QA Verify"
      },
      {
        "command": "vibeflow.qaReject",
        "title": "VibeFlow: QA Reject"
      },
      {
        "command": "vibeflow.securityApprove",
        "title": "VibeFlow: Security Approve"
      },
      {
        "command": "vibeflow.securityReject",
        "title": "VibeFlow: Security Reject"
      },
      {
        "command": "vibeflow.refresh",
        "title": "VibeFlow: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "vibeflow.clearActivityFeed",
        "title": "VibeFlow: Clear Activity Feed",
        "icon": "$(clear-all)"
      },
      {
        "command": "vibeflow.openSettings",
        "title": "VibeFlow: Settings",
        "icon": {
          "light": "media/settings.svg",
          "dark": "media/settings.svg"
        }
      },
      {
        "command": "vibeflow.focusTerminal",
        "title": "VibeFlow: Focus Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "vibeflow.openSessionPanel",
        "title": "VibeFlow: View Session Details"
      },
      {
        "command": "vibeflow.killSession",
        "title": "VibeFlow: Kill Session",
        "icon": "$(stop)"
      },
      {
        "command": "vibeflow.restartSession",
        "title": "VibeFlow: Restart Session",
        "icon": "$(debug-restart)"
      },
      {
        "command": "vibeflow.deleteSession",
        "title": "VibeFlow: Delete Session",
        "icon": "$(trash)"
      },
      {
        "command": "vibeflow.killAndForgetSession",
        "title": "VibeFlow: Kill Session & Forget",
        "icon": "$(close-all)"
      },
      {
        "command": "vibeflow.copySessionId",
        "title": "VibeFlow: Copy Session ID",
        "icon": "$(copy)"
      },
      {
        "command": "vibeflow.dismissFailedPending",
        "title": "VibeFlow: Dismiss Failed Pending Session",
        "icon": "$(close)"
      },
      {
        "command": "vibeflow.cancelStartingPending",
        "title": "VibeFlow: Cancel Starting Session",
        "icon": "$(stop)"
      },
      {
        "command": "vibeflow.showAllTerminals",
        "title": "VibeFlow: Show All Agent Terminals",
        "icon": "$(eye)"
      },
      {
        "command": "vibeflow.openAgentActivity",
        "title": "VibeFlow: Show Agent Activity",
        "icon": "$(output)"
      },
      {
        "command": "vibeflow.chat.askSelection",
        "title": "VibeFlow: Ask Agent About Selection",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "vibeflow.openWorkItemPanel",
        "title": "VibeFlow: Open Work Item Panel"
      },
      {
        "command": "vibeflow.openCli",
        "title": "VibeFlow: Open CLI",
        "icon": "$(terminal)"
      },
      {
        "command": "vibeflow.openWorktreeInNewWindow",
        "title": "VibeFlow: Open Worktree in New Window",
        "icon": "$(folder-opened)"
      },
      {
        "command": "vibeflow.deleteWorktreeFromTree",
        "title": "VibeFlow: Delete Worktree",
        "icon": "$(trash)"
      },
      {
        "command": "vibeflow.createSessionInWorktree",
        "title": "VibeFlow: Create Session Here",
        "icon": "$(rocket)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "vibeflow.chat.askSelection",
          "when": "editorHasSelection",
          "group": "vibeflow@1"
        }
      ],
      "view/item/context": [
        {
          "command": "vibeflow.focusTerminal",
          "when": "view == vibeflow.agentFleet && viewItem == activeSession",
          "group": "session@0"
        },
        {
          "command": "vibeflow.killSession",
          "when": "view == vibeflow.agentFleet && viewItem == activeSession",
          "group": "session@1"
        },
        {
          "command": "vibeflow.restartSession",
          "when": "view == vibeflow.agentFleet && viewItem == activeSession",
          "group": "session@2"
        },
        {
          "command": "vibeflow.openSessionPanel",
          "when": "view == vibeflow.agentFleet && (viewItem == activeSession || viewItem == inactiveSession)",
          "group": "session@3"
        },
        {
          "command": "vibeflow.copySessionId",
          "when": "view == vibeflow.agentFleet && (viewItem == activeSession || viewItem == inactiveSession)",
          "group": "session@4"
        },
        {
          "command": "vibeflow.deleteSession",
          "when": "view == vibeflow.agentFleet && viewItem == inactiveSession",
          "group": "session_destructive@0"
        },
        {
          "command": "vibeflow.killAndForgetSession",
          "when": "view == vibeflow.agentFleet && (viewItem == activeSession || viewItem == inactiveSession)",
          "group": "session_destructive@1"
        },
        {
          "command": "vibeflow.dismissFailedPending",
          "when": "view == vibeflow.agentFleet && viewItem == pendingSessionFailed",
          "group": "inline"
        },
        {
          "command": "vibeflow.dismissFailedPending",
          "when": "view == vibeflow.agentFleet && viewItem == pendingSessionFailed",
          "group": "session_destructive@0"
        },
        {
          "command": "vibeflow.cancelStartingPending",
          "when": "view == vibeflow.agentFleet && viewItem == pendingSessionStarting",
          "group": "inline"
        },
        {
          "command": "vibeflow.cancelStartingPending",
          "when": "view == vibeflow.agentFleet && viewItem == pendingSessionStarting",
          "group": "session_destructive@0"
        },
        {
          "command": "vibeflow.openWorkItemPanel",
          "when": "view == vibeflow.workItems && viewItem =~ /^(todo|issue)-/",
          "group": "navigation@0"
        },
        {
          "command": "vibeflow.changeStatus",
          "when": "view == vibeflow.workItems && viewItem =~ /^(todo|issue)-/",
          "group": "navigation@1"
        },
        {
          "command": "vibeflow.changePriority",
          "when": "view == vibeflow.workItems && viewItem =~ /^(todo|issue)-/",
          "group": "navigation@2"
        },
        {
          "command": "vibeflow.qaVerify",
          "when": "view == vibeflow.workItems && viewItem =~ /^(todo|issue)-done$/",
          "group": "review@0"
        },
        {
          "command": "vibeflow.qaReject",
          "when": "view == vibeflow.workItems && viewItem =~ /^(todo|issue)-done$/",
          "group": "review@1"
        },
        {
          "command": "vibeflow.securityApprove",
          "when": "view == vibeflow.workItems && viewItem =~ /^(todo|issue)-/",
          "group": "review@2"
        },
        {
          "command": "vibeflow.securityReject",
          "when": "view == vibeflow.workItems && viewItem =~ /^(todo|issue)-/",
          "group": "review@3"
        },
        {
          "command": "vibeflow.createSessionInWorktree",
          "when": "view == vibeflow.agentFleet && viewItem == worktreeItem",
          "group": "worktree@0"
        },
        {
          "command": "vibeflow.openWorktreeInNewWindow",
          "when": "view == vibeflow.agentFleet && viewItem == worktreeItem",
          "group": "worktree@1"
        },
        {
          "command": "vibeflow.deleteWorktreeFromTree",
          "when": "view == vibeflow.agentFleet && viewItem == worktreeItem",
          "group": "worktree@2"
        }
      ],
      "view/title": [
        {
          "command": "vibeflow.openSettings",
          "when": "view == vibeflow.agentFleet",
          "group": "navigation@99"
        },
        {
          "command": "vibeflow.launchSession",
          "when": "view == vibeflow.agentFleet && !config.vibeflow.cli.enabled",
          "group": "navigation@1"
        },
        {
          "command": "vibeflow.openCli",
          "when": "view == vibeflow.agentFleet && config.vibeflow.cli.enabled",
          "group": "navigation@1"
        },
        {
          "command": "vibeflow.openDashboard",
          "when": "view == vibeflow.agentFleet",
          "group": "navigation@2"
        },
        {
          "command": "vibeflow.openBrainstorm",
          "when": "view == vibeflow.agentFleet",
          "group": "navigation@3"
        },
        {
          "command": "vibeflow.refresh",
          "when": "view == vibeflow.agentFleet",
          "group": "navigation@4"
        },
        {
          "command": "vibeflow.showAllTerminals",
          "when": "view == vibeflow.agentFleet",
          "group": "navigation@5"
        },
        {
          "command": "vibeflow.createWorkItem",
          "when": "view == vibeflow.workItems",
          "group": "navigation@1"
        },
        {
          "command": "vibeflow.openKanban",
          "when": "view == vibeflow.workItems",
          "group": "navigation@2"
        },
        {
          "command": "vibeflow.openCompliance",
          "when": "view == vibeflow.workItems",
          "group": "navigation@3"
        },
        {
          "command": "vibeflow.refresh",
          "when": "view == vibeflow.workItems",
          "group": "navigation@4"
        },
        {
          "command": "vibeflow.openSettings",
          "when": "view == vibeflow.workItems",
          "group": "navigation@99"
        },
        {
          "command": "vibeflow.createDocument",
          "when": "view == vibeflow.documents",
          "group": "navigation@1"
        },
        {
          "command": "vibeflow.refresh",
          "when": "view == vibeflow.documents",
          "group": "navigation@2"
        },
        {
          "command": "vibeflow.openSettings",
          "when": "view == vibeflow.documents",
          "group": "navigation@99"
        },
        {
          "command": "vibeflow.clearActivityFeed",
          "when": "view == vibeflow.activityFeed",
          "group": "navigation@1"
        },
        {
          "command": "vibeflow.openSettings",
          "when": "view == vibeflow.activityFeed",
          "group": "navigation@99"
        }
      ]
    },
    "keybindings": [
      {
        "command": "vibeflow.openKanban",
        "key": "ctrl+shift+v k",
        "mac": "cmd+shift+v k"
      },
      {
        "command": "vibeflow.openDashboard",
        "key": "ctrl+shift+v d",
        "mac": "cmd+shift+v d"
      },
      {
        "command": "vibeflow.openCompliance",
        "key": "ctrl+shift+v c",
        "mac": "cmd+shift+v c"
      },
      {
        "command": "vibeflow.openBrainstorm",
        "key": "ctrl+shift+v b",
        "mac": "cmd+shift+v b"
      },
      {
        "command": "vibeflow.pickProject",
        "key": "ctrl+shift+v p",
        "mac": "cmd+shift+v p"
      },
      {
        "command": "vibeflow.respondToPrompt",
        "key": "ctrl+shift+v r",
        "mac": "cmd+shift+v r"
      },
      {
        "command": "vibeflow.launchSession",
        "key": "ctrl+shift+v l",
        "mac": "cmd+shift+v l"
      },
      {
        "command": "vibeflow.createWorkItem",
        "key": "ctrl+shift+v n",
        "mac": "cmd+shift+v n"
      },
      {
        "command": "vibeflow.openSettings",
        "key": "ctrl+shift+v s",
        "mac": "cmd+shift+v s"
      },
      {
        "command": "vibeflow.refresh",
        "key": "ctrl+shift+v f",
        "mac": "cmd+shift+v f"
      },
      {
        "command": "workbench.action.terminal.sendSequence",
        "args": {
          "text": "\u0011"
        },
        "key": "ctrl+q",
        "mac": "ctrl+q",
        "when": "terminalFocus && config.vibeflow.cli.enabled"
      },
      {
        "command": "workbench.action.terminal.sendSequence",
        "args": {
          "text": "\u001c"
        },
        "key": "ctrl+\\",
        "mac": "ctrl+\\",
        "when": "terminalFocus && config.vibeflow.cli.enabled"
      }
    ],
    "walkthroughs": [
      {
        "id": "vibeflow.getStarted",
        "title": "Get Started with VibeFlow",
        "description": "Stand up a multi-persona AI agent team inside your IDE — five quick steps from sign-in to your first running session.",
        "steps": [
          {
            "id": "welcome",
            "title": "Welcome to VibeFlow",
            "description": "Run a full software team — **Developer, Architect, QA, Security, Product Manager** — as autonomous AI agents inside VS Code. Each persona owns its workflow; you coordinate from the sidebar.\n\n[Learn more](https://axiomstudio.ai/vibeflow)",
            "media": {
              "image": "media/vibeflow-icon.svg",
              "altText": "VibeFlow"
            },
            "completionEvents": [
              "onLink:https://axiomstudio.ai/vibeflow"
            ]
          },
          {
            "id": "setup",
            "title": "Sign in",
            "description": "Connect to your VibeFlow workspace with the API key from your **Account → API Keys** page. We remember it across restarts, and the CLI and extension share the same identity once you sign in here.\n\n[Run Setup](command:vibeflow.setup)",
            "media": {
              "image": "media/vibeflow-icon.svg",
              "altText": "Sign in"
            },
            "completionEvents": [
              "onCommand:vibeflow.setup"
            ]
          },
          {
            "id": "launch",
            "title": "Launch your first agent",
            "description": "Pick a persona, AI provider, and branch — the wizard handles the rest. Your agent boots in a per-persona terminal and starts polling for work the moment it lands.\n\n[Launch Session](command:vibeflow.launchSession)",
            "media": {
              "image": "media/vibeflow-icon.svg",
              "altText": "Launch"
            },
            "completionEvents": [
              "onCommand:vibeflow.launchSession"
            ]
          },
          {
            "id": "respond",
            "title": "Stay in the loop",
            "description": "When an agent needs your input — an architecture decision, a security tradeoff, a scope check — a notification surfaces in the status bar and on the Agent Fleet tree. Click **Respond** to weigh in without leaving the editor.\n\n[Respond to a Prompt](command:vibeflow.respondToPrompt)",
            "media": {
              "image": "media/vibeflow-icon.svg",
              "altText": "Respond"
            },
            "completionEvents": [
              "onCommand:vibeflow.respondToPrompt"
            ]
          },
          {
            "id": "explore",
            "title": "Explore the workspace",
            "description": "Click the VibeFlow icon in the Activity Bar to open four live views:\n\n- **Agent Fleet** — your running agents, grouped by branch\n- **Work Items** — todos and issues across your projects\n- **Activity Feed** — real-time stream of every agent action\n- **Documents** — PRDs, architecture, style guides, design system\n\n[Open Sidebar](command:vibeflow.viewSessions)",
            "media": {
              "image": "media/vibeflow-icon.svg",
              "altText": "Sidebar"
            },
            "completionEvents": [
              "onCommand:vibeflow.viewSessions"
            ]
          }
        ]
      }
    ],
    "configuration": {
      "title": "VibeFlow",
      "properties": {
        "vibeflow.serverUrl": {
          "type": "string",
          "default": "https://cloud.axiomstudio.ai",
          "description": "VibeFlow server URL"
        },
        "vibeflow.defaultProvider": {
          "type": "string",
          "default": "claude",
          "description": "Default agent provider"
        },
        "vibeflow.cli.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Use the VibeFlow CLI (TUI) for session management instead of per-persona VS Code terminals. The left sidebar still shows live agent state. Requires the `vibeflow` binary on PATH — install from https://github.com/axiom-studio/vibeflow-cli/releases."
        },
        "vibeflow.cli.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to the vibeflow CLI binary. Leave empty to use PATH lookup."
        },
        "vibeflow.session.reattachMode": {
          "type": "string",
          "enum": [
            "vanilla",
            "vibeflow"
          ],
          "default": "vanilla",
          "description": "Mode used when reattaching phantom sessions on window reload. 'vanilla' (default) preserves the safe per-action permission prompts; 'vibeflow' reattaches in skip-permissions mode (only do this if your prior session was launched in vibeflow mode and you trust the agent to keep running unattended)."
        },
        "vibeflow.polling.interval": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "maximum": 300,
          "description": "UI refresh interval in seconds"
        },
        "vibeflow.debug.polling": {
          "type": "boolean",
          "default": false,
          "description": "Log poll activity — each refresh, plus pause/resume on window focus — to the \"VibeFlow Polling\" output channel. For debugging the polling coordinator."
        },
        "vibeflow.notifications.agentPrompts": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications for agent prompts"
        },
        "vibeflow.notifications.workItemComplete": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications when work items complete"
        },
        "vibeflow.session.terminalMode": {
          "type": "string",
          "default": "hybrid",
          "enum": [
            "hybrid",
            "all",
            "none"
          ],
          "enumDescriptions": [
            "Code agents (Dev/Arch/PE) visible, advisory agents hidden",
            "All agent terminals visible",
            "All agent terminals hidden (background only)"
          ],
          "description": "Controls terminal visibility when launching agent sessions"
        },
        "vibeflow.session.headlessBacking": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "tmux",
            "vscode"
          ],
          "enumDescriptions": [
            "tmux when available (Mac / Linux with tmux installed), otherwise a hidden VS Code terminal. Recommended — tmux is the only backing that supports multi-turn chat today.",
            "Always use tmux (Unix only; ignored on Windows). Agent survives IDE restart; attach via `tmux -L vibeflow-headless attach -t <name>`",
            "Always use a hidden VS Code terminal — chat-first agent is tied to this IDE window's lifetime AND only handles a single chat turn before exiting"
          ],
          "description": "Runtime backing for chat-first / headless agent sessions. 'auto' picks tmux when available (multi-turn chat works) and falls back to a hidden VS Code terminal (single-turn only). 'tmux' lets the agent survive IDE restart and be observed via `tmux -L vibeflow-headless attach -t <name>` from any terminal. 'vscode' forces the IDE-tied single-turn backing."
        },
        "vibeflow.chat.diffView": {
          "type": "string",
          "enum": [
            "unified",
            "split"
          ],
          "default": "unified",
          "description": "How diff code blocks render in the Session Chat panel. 'unified' stacks added/removed lines vertically with a +/- gutter. 'split' renders before / after in two columns aligned by hunk. Either way, the 'Open in Editor' button on each diff opens VSCode's native diff editor for full review."
        },
        "vibeflow.chat.showTmuxAttachButton": {
          "type": "boolean",
          "default": true,
          "description": "Show a button in the chat-first Session Chat header that opens this session's tmux shell in a VSCode integrated terminal (tmux -L vibeflow-headless attach -t <name>), so you can watch or step through the raw agent exchange for debugging. Only appears for chat-first sessions backed by tmux. Enabled by default."
        },
        "vibeflow.worktree.baseDir": {
          "type": "string",
          "default": ".claude/worktrees",
          "description": "Subdirectory (relative to the workspace root) where the extension creates git worktrees for cross-branch agent sessions."
        },
        "vibeflow.worktree.autoCreate": {
          "type": "boolean",
          "default": false,
          "description": "Automatically create a git worktree when launching a session against a branch that doesn't already have one."
        },
        "vibeflow.worktree.cleanupOnKill": {
          "type": "string",
          "enum": [
            "ask",
            "always",
            "never"
          ],
          "default": "ask",
          "description": "Cleanup policy when an agent session ends. 'ask' prompts every time; 'always' deletes the worktree; 'never' keeps it for follow-up work."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn build",
    "build:webview": "yarn --cwd webview-ui build",
    "build:extension": "node esbuild.mjs --production",
    "check:security-guards": "node scripts/check-security-guards.mjs",
    "build": "yarn check:security-guards && yarn build:webview && yarn build:extension",
    "watch": "node esbuild.mjs --watch",
    "watch:webview": "yarn --cwd webview-ui dev",
    "dev": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "package": "yarn build && vsce package",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration:compile": "tsc -p tsconfig.test-integration.json",
    "test:integration": "yarn test:integration:compile && node out/test/test/integration/runTest.js",
    "check": "yarn typecheck && yarn lint && yarn test && yarn check:security-guards"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.93.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.24.0",
    "eslint": "^8.57.0",
    "mocha": "^11.7.6",
    "typescript": "^5.6.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  }
}
