{
  "name": "vscode-vibeflow",
  "displayName": "VibeFlow",
  "description": "AI agent orchestration, project management, and governance for VSCode",
  "version": "0.1.0",
  "publisher": "axiom-studio",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git@bitbucket.org:axiom-studio/vscode-vibeflow.git"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.vibeflow-session-*",
    "onStartupFinished"
  ],
  "icon": "media/icon.png",
  "keywords": [
    "ai",
    "agent",
    "vibeflow",
    "orchestration",
    "multi-agent",
    "project-management"
  ],
  "bugs": {
    "url": "https://bitbucket.org/axiom-studio/vscode-vibeflow/issues"
  },
  "homepage": "https://cloud.axiomstudio.ai",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vibeflow",
          "title": "VibeFlow",
          "icon": "media/vibeflow-icon.svg"
        },
        {
          "id": "vibeflowMonitor",
          "title": "VibeFlow Monitor",
          "icon": "media/vibeflow-icon.svg"
        }
      ]
    },
    "views": {
      "vibeflow": [
        {
          "id": "vibeflow.agentFleet",
          "name": "Agent Fleet",
          "type": "tree"
        },
        {
          "id": "vibeflow.workItems",
          "name": "Work Items",
          "type": "tree"
        },
        {
          "id": "vibeflow.documents",
          "name": "Documents",
          "type": "tree",
          "visibility": "collapsed"
        }
      ],
      "vibeflowMonitor": [
        {
          "id": "vibeflow.activityFeed",
          "name": "Activity Feed",
          "type": "webview"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "vibeflow.chat",
        "name": "vibeflow",
        "fullName": "VibeFlow",
        "description": "AI agent orchestration and project management",
        "isSticky": false,
        "commands": [
          {
            "name": "status",
            "description": "Check project, feature, and session status"
          },
          {
            "name": "create",
            "description": "Create a feature, todo, or issue"
          },
          {
            "name": "review",
            "description": "View items needing QA or security review"
          },
          {
            "name": "summary",
            "description": "Get work summary and metrics"
          },
          {
            "name": "launch",
            "description": "Launch an agent session"
          },
          {
            "name": "respond",
            "description": "Respond to a pending agent prompt"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "vibeflow.setup",
        "title": "VibeFlow: Setup"
      },
      {
        "command": "vibeflow.login",
        "title": "VibeFlow: Login"
      },
      {
        "command": "vibeflow.logout",
        "title": "VibeFlow: Logout"
      },
      {
        "command": "vibeflow.launchSession",
        "title": "VibeFlow: Launch Session",
        "icon": "$(play)"
      },
      {
        "command": "vibeflow.createWorkItem",
        "title": "VibeFlow: Create Work Item",
        "icon": "$(add)"
      },
      {
        "command": "vibeflow.viewSessions",
        "title": "VibeFlow: View Sessions"
      },
      {
        "command": "vibeflow.respondToPrompt",
        "title": "VibeFlow: Respond to Prompt"
      },
      {
        "command": "vibeflow.openDashboard",
        "title": "VibeFlow: Open Dashboard"
      },
      {
        "command": "vibeflow.openKanban",
        "title": "VibeFlow: Open Kanban Board"
      },
      {
        "command": "vibeflow.manageWorktrees",
        "title": "VibeFlow: Manage Worktrees"
      },
      {
        "command": "vibeflow.refresh",
        "title": "VibeFlow: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "vibeflow.openSettings",
        "title": "VibeFlow: Settings",
        "icon": {
          "light": "media/settings.svg",
          "dark": "media/settings.svg"
        }
      },
      {
        "command": "vibeflow.focusTerminal",
        "title": "VibeFlow: Focus Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "vibeflow.openSessionPanel",
        "title": "VibeFlow: View Session Details"
      },
      {
        "command": "vibeflow.killSession",
        "title": "VibeFlow: Kill Session",
        "icon": "$(stop)"
      },
      {
        "command": "vibeflow.restartSession",
        "title": "VibeFlow: Restart Session",
        "icon": "$(debug-restart)"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "vibeflow.focusTerminal",
          "when": "view == vibeflow.agentFleet && viewItem == activeSession",
          "group": "session@0"
        },
        {
          "command": "vibeflow.killSession",
          "when": "view == vibeflow.agentFleet && viewItem == activeSession",
          "group": "session@1"
        },
        {
          "command": "vibeflow.restartSession",
          "when": "view == vibeflow.agentFleet && viewItem == activeSession",
          "group": "session@2"
        },
        {
          "command": "vibeflow.openSessionPanel",
          "when": "view == vibeflow.agentFleet && (viewItem == activeSession || viewItem == inactiveSession)",
          "group": "session@3"
        }
      ],
      "view/title": [
        {
          "command": "vibeflow.openSettings",
          "when": "view =~ /^vibeflow\\./",
          "group": "navigation@99"
        },
        {
          "command": "vibeflow.launchSession",
          "when": "view == vibeflow.agentFleet",
          "group": "navigation"
        },
        {
          "command": "vibeflow.refresh",
          "when": "view == vibeflow.agentFleet",
          "group": "navigation"
        },
        {
          "command": "vibeflow.createWorkItem",
          "when": "view == vibeflow.workItems",
          "group": "navigation"
        },
        {
          "command": "vibeflow.refresh",
          "when": "view == vibeflow.workItems",
          "group": "navigation"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "vibeflow.getStarted",
        "title": "Get Started with VibeFlow",
        "description": "Set up your AI agent orchestration environment in 5 steps.",
        "steps": [
          {
            "id": "welcome",
            "title": "Welcome to VibeFlow",
            "description": "VibeFlow brings multi-persona AI agent orchestration into your IDE. Run Developer, Architect, QA, Security, and PM agents — all from VSCode.\n\n[Learn more](https://cloud.axiomstudio.ai)",
            "media": { "image": "media/vibeflow-icon.svg", "altText": "VibeFlow logo" }
          },
          {
            "id": "setup",
            "title": "Connect to VibeFlow",
            "description": "Paste your API key from Account > API Keys to connect.\n\n[Run Setup](command:vibeflow.setup)",
            "media": { "image": "media/vibeflow-icon.svg", "altText": "Setup" },
            "completionEvents": ["onCommand:vibeflow.setup"]
          },
          {
            "id": "launch",
            "title": "Launch Your First Session",
            "description": "Pick a persona, provider, and branch. The agent runs in an integrated terminal.\n\n[Launch Session](command:vibeflow.launchSession)",
            "media": { "image": "media/vibeflow-icon.svg", "altText": "Launch" },
            "completionEvents": ["onCommand:vibeflow.launchSession"]
          },
          {
            "id": "respond",
            "title": "Respond to Agent Prompts",
            "description": "When an agent needs your input, a notification appears. Click Respond to answer.\n\n[Respond to Prompt](command:vibeflow.respondToPrompt)",
            "media": { "image": "media/vibeflow-icon.svg", "altText": "Respond" },
            "completionEvents": ["onCommand:vibeflow.respondToPrompt"]
          },
          {
            "id": "explore",
            "title": "Explore the Sidebar",
            "description": "Click the VibeFlow icon in the Activity Bar to see Agent Fleet, Work Items, Activity Feed, and Documents.\n\n[Open Sidebar](command:vibeflow.viewSessions)",
            "media": { "image": "media/vibeflow-icon.svg", "altText": "Sidebar" },
            "completionEvents": ["onCommand:vibeflow.viewSessions"]
          }
        ]
      }
    ],
    "configuration": {
      "title": "VibeFlow",
      "properties": {
        "vibeflow.serverUrl": {
          "type": "string",
          "default": "https://cloud.axiomstudio.ai",
          "description": "VibeFlow server URL"
        },
        "vibeflow.defaultPersona": {
          "type": "string",
          "default": "developer",
          "enum": [
            "developer",
            "architect",
            "principal_engineer",
            "security_lead",
            "qa_lead",
            "product_manager",
            "project_manager",
            "ux_designer",
            "customer"
          ],
          "description": "Default persona for new sessions"
        },
        "vibeflow.defaultProvider": {
          "type": "string",
          "default": "claude",
          "description": "Default agent provider"
        },
        "vibeflow.autoDetectProject": {
          "type": "boolean",
          "default": true,
          "description": "Auto-match git remote to VibeFlow project"
        },
        "vibeflow.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show VibeFlow status bar items"
        },
        "vibeflow.polling.interval": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "maximum": 300,
          "description": "UI refresh interval in seconds"
        },
        "vibeflow.notifications.agentPrompts": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications for agent prompts"
        },
        "vibeflow.notifications.workItemComplete": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications when work items complete"
        },
        "vibeflow.session.terminalMode": {
          "type": "string",
          "default": "hybrid",
          "enum": ["hybrid", "all", "none"],
          "enumDescriptions": [
            "Code agents (Dev/Arch/PE) visible, advisory agents hidden",
            "All agent terminals visible",
            "All agent terminals hidden (background only)"
          ],
          "description": "Controls terminal visibility when launching agent sessions"
        },
        "vibeflow.debug.simulateActivity": {
          "type": "boolean",
          "default": true,
          "description": "Fill the Activity Feed with simulated dummy data (for development/testing)"
        },
        "vibeflow.devMode.workspaceFolder": {
          "type": "string",
          "default": "",
          "description": "DEV ONLY: Absolute path to a folder to auto-open when the extension activates with no workspace. Use for F5 debugging."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn build",
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "dev": "node esbuild.mjs --watch",
    "lint": "eslint src/",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.93.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^8.57.0",
    "typescript": "^5.6.0"
  }
}
