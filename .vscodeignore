.vscode/**
.vscode-test/**
.claude/**
src/**
webview-ui/src/**
webview-ui/node_modules/**
webview-ui/package.json
webview-ui/tsconfig.json
webview-ui/vite.config.ts
webview-ui/yarn.lock
webview-ui/index.html
node_modules/**
tsconfig.json
esbuild.mjs
.eslintrc.json
.gitignore
.git/**
**/*.map
docs/**
.vibeflow-session-*
.mcp.json
# .gemini/ — gemini-cli tool config. Contains an Authorization: Bearer
# <jwt> for the vibeflow MCP endpoint (same shape as .mcp.json above).
# .gitignore covers the git path but `vsce package` reads from disk, so
# this MUST also be excluded here or the JWT ships in the .vsix. #2340.
.gemini/**
# Dev-only diagnostic scripts that may sit at the repo root during
# debugging. None are runtime extension code; excluding by glob so the
# next one a developer drops doesn't accidentally ship.
init_*.mjs
debug_*.mjs
*.bak
.idea/**
CLAUDE.md
AGENTS.md
GEMINI.md
QWEN.md
# 1.0.4: integration-test compile output + test configs + dev-only scripts.
# The integration cohort (Phase 5-A2 #1980) compiles src/test/** to out/test/
# via tsconfig.test-integration.json — but those compiled .js files are
# Mocha specs for the extension host, not anything end users need. Without
# these excludes the .vsix would ship ~794 KB of dead-weight test JS (83
# files), doubling the package size for zero user value.
out/**
TESTING.md
tsconfig.test.json
tsconfig.test-integration.json
vitest.config.ts
scripts/**
# Agent/dev tooling that lives in the repo but is NOT runtime extension code:
# the `.agents/` skills dir + its lockfile, the webview test config, and the
# GitHub issue templates. Without these, `vsce package` shipped ~220 KB of
# internal tooling (59 skill files) into the .vsix for end users. (1.1.3)
.agents/**
skills-lock.json
webview-ui/vitest.config.ts
.github/**
