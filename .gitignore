# Node
node_modules/
dist/

# VS Code Extension
*.vsix
out/

# Webview build output
webview-ui/dist/

# Integration test compile output + downloaded VS Code build
out/
.vscode-test/

# Build artifacts
*.map

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.claude/

# Session files (local agent state)
.vibeflow-session-*

# MCP config — written by the extension with a Bearer token in args.
# Must never be committed.
.mcp.json

# Gemini-side tool config — `.gemini/settings.json` contains an
# Authorization: Bearer <jwt> for the vibeflow MCP endpoint, same as
# .mcp.json above. Mirror the rule: ignore the whole tool config dir
# (same convention as .claude/ on line 25). Build-time guard lives in
# scripts/check-security-guards.mjs to catch a future revert.
.gemini/

# Agent doc files written by the extension into a workspace at activation
# (claude/codex/cursor/gemini). Source-of-truth lives under media/agentdocs/.
/AGENTS.md
/CLAUDE.md
/GEMINI.md

# Test reports
TEST*.xml

# Logs
*.log

# Yarn
.yarn/cache
.yarn/unplugged
.pnp.*

# Agent skills (locally installed)
.agents/
skills-lock.json
